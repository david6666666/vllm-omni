[
  {
    "test_name": "test_minimax_h3_t2v_4gpu",
    "mark": [
      {
        "hardware_marks": {
          "res": {
            "cuda": "H100"
          },
          "num_cards": 4
        }
      },
      "full_model",
      "diffusion"
    ],
    "description": "MiniMax-H3 T2VA text-to-video+audio on 4 GPUs (encoder-TP4, DiT TP2+USP2, VAE-PP4 tile)",
    "server_type": "vllm-omni",
    "benchmark_endpoint": "/v1/videos",
    "server_params": {
      "model": "MiniMaxAI/MiniMax-H3/FL2VA",
      "serve_args": {
        "trust-remote-code": true,
        "num-gpus": 4,
        "tensor-parallel-size": 2,
        "usp": 2,
        "ring": 1,
        "text-encoder-tp-size": 4,
        "vae-patch-parallel-size": 4,
        "vae-parallel-mode": "tile",
        "vae-use-tiling": true,
        "diffusion-attention-backend": "FLASH_ATTN",
        "stage-init-timeout": 1800,
        "init-timeout": 1800,
        "enable-diffusion-pipeline-profiler": true
      }
    },
    "benchmark_params": [
      {
        "name": "1344x768_frames209_steps50",
        "dataset": "random",
        "task": "t2v",
        "num-prompts": 3,
        "max-concurrency": 1,
        "warmup-requests": 1,
        "warmup-concurrency": 1,
        "seed": 42,
        "random-request-config": [
          {
            "width": 1344,
            "height": 768,
            "prompt": "Cinematic drone shot pushing through misty mountain ridges at sunrise, golden light catching the clouds, slow and smooth.",
            "num_inference_steps": 50,
            "num_frames": 209,
            "fps": 24,
            "weight": 1
          }
        ],
        "extra-body": {
          "flow_shift": 12.0,
          "extra_params": "{\"task\":\"t2va\",\"duration\":8.7,\"aspect_ratio\":\"16:9\",\"audio_flow_shift\":3.0}"
        },
        "baseline": {
          "B300": {
            "throughput_qps": 0.0093,
            "latency_mean": 107.111,
            "peak_memory_mb_mean": 71932.0
          }
        }
      }
    ]
  },
